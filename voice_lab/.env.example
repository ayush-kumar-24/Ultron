# Optional Kokoro overrides (default offline voice)
# KOKORO_VOICE=af_heart
# KOKORO_LANG=a

# Indic Parler-TTS (AI4Bharat) — first run downloads ~1GB+
# PARLER_SPEAKER=Divya
# PARLER_DEVICE=auto
PARLER_ALLOW_DOWNLOAD=0

# Veena (Maya Research) — first run downloads multi-GB; GPU recommended
# VEENA_SPEAKER=kavya
# VEENA_DEVICE=auto
VEENA_ALLOW_DOWNLOAD=0

# Optional Chatterbox
# CHATTERBOX_DEVICE=cpu
# CHATTERBOX_VOICE_PROMPT=
CHATTERBOX_ALLOW_DOWNLOAD=0
